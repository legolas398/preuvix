# Copy to .env.production at the repository root. Do not reuse the local password.
PREUVIX_DOMAIN=preuvix.example.com
ACME_EMAIL=operator@example.com
OWNER_PASSWORD=replace-with-a-long-random-password
MOBILE_ENABLED=true
MAX_STORAGE_MB=500
# Explicit private pilot, without a configured qualified timestamp service.
REQUIRE_TIMESTAMP=false
PRIVATE_PROTOTYPE=true
STRIPE_ALLOW_LIVE=false
