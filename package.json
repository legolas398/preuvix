{
  "name": "preuvix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "key:rotate": "node scripts/rotate-key.mjs",
    "timestamp:check": "tsx scripts/check-timestamp.ts",
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "format": "prettier --write src server shared tests scripts *.json *.ts README.md compose.yaml",
    "format:check": "prettier --check src server shared tests scripts *.json *.ts README.md compose.yaml",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@contentauth/c2pa-node": "^0.9.9",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/leaflet": "^1.9.22",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "exifr": "^7.1.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "fflate": "^0.8.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "helmet": "^8.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2",
    "tsx": "^4.20.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
