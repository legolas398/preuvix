# One private owner workspace per installation. No public registration.
OWNER_PASSWORD=12345
APP_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
MAX_STORAGE_MB=500
# Use HTTPS + COOKIE_SECURE=true on a public installation.
COOKIE_SECURE=false
# Optional RFC 3161 service. Never put a secret in a public frontend variable.
TSA_URL=
TSA_AUTHORIZATION=
TSA_NAME=
TSA_CA_FILE=
TSA_POLICY_OID=
TSA_SIGNER_SHA256=
OPENSSL_BIN=openssl
# Evidence of an operator's qualified-service review, NOT automated eIDAS validation.
TSA_TRUST_LIST_URL=
TSA_REVIEW_VALID_UNTIL=
# Production startup fails without all timestamp configuration and a current review.
REQUIRE_TIMESTAMP=true
# Optional PEM bundle of C2PA trust anchors (official C2PA trust list). Without it,
# camera signatures are validated but no signer is reported as trusted.
C2PA_TRUST_ANCHORS=

# Stripe: monthly EUR 10.99 recurring Price. Keep secrets on the server.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Explicit opt-in required for live keys, alongside HTTPS and secure cookies.
STRIPE_ALLOW_LIVE=false
# Premium application storage limit (does not provision disk or hosting).
PREMIUM_STORAGE_MB=5000
